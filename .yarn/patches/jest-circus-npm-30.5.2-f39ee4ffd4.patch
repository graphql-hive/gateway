+const runInTestExecutionContext = (context, callback) => {
+  const id = testExecutionContexts.size + 1;
+  testExecutionContexts.set(id, {
+    ...getTestExecutionContext(),
+    ...context
+  });
+  return testExecutionContext.run(id, callback);
+};
 exports.runInTestExecutionContext = runInTestExecutionContext;
