{
  "name": "@graphql-hive/plugin-opentelemetry",
  "version": "1.5.15",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphql-hive/gateway.git",
    "directory": "packages/plugins/opentelemetry"
  },
  "author": {
    "email": "contact@the-guild.dev",
    "name": "The Guild",
    "url": "https://the-guild.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./setup": {
      "require": {
        "types": "./dist/setup.d.cts",
        "default": "./dist/setup.cjs"
      },
      "import": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      }
    },
    "./api": {
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      },
      "import": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      }
    },
    "./attributes": {
      "require": {
        "types": "./dist/attributes.d.cts",
        "default": "./dist/attributes.cjs"
      },
      "import": {
        "types": "./dist/attributes.d.ts",
        "default": "./dist/attributes.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll --clean-dist && tsx scripts/inject-version",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "graphql": "^16.9.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-hive/core": "^0.24.0",
    "@graphql-hive/gateway-runtime": "workspace:^",
    "@graphql-hive/logger": "workspace:^",
    "@graphql-mesh/cross-helpers": "^0.4.18",
    "@graphql-mesh/transport-common": "workspace:^",
    "@graphql-mesh/types": "^0.107.3",
    "@graphql-mesh/utils": "^0.107.3",
    "@graphql-tools/utils": "^13.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@whatwg-node/promise-helpers": "^2.0.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@types/opossum": "^8.1.9",
    "@whatwg-node/server": "^0.13.3",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.1",
    "opossum": "patch:opossum@npm%3A9.0.0#~/.yarn/patches/opossum-npm-9.0.0-a0de5b75b9.patch",
    "pkgroll": "2.29.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15"
  },
  "sideEffects": false
}
